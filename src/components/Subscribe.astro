---
/**
 * Subscribe — posts directly to Substack via a native form.
 * Native form POST avoids CORS; Substack handles confirmation.
 * On submit the user is redirected to Substack's confirmation page
 * in a new tab; the page-level message updates immediately.
 */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section
  class={`subscribe-block${compact ? ' subscribe-block--compact' : ''}`}
  id="subscribe"
  aria-labelledby="subscribe-heading"
>
  <div class="subscribe-block__inner">
    {!compact && <p class="subscribe-block__label">Stay in touch</p>}

    <h2 class="subscribe-block__heading" id="subscribe-heading">
      {compact
        ? 'Get new essays by email.'
        : 'Occasional essays and notes on higher education marketing, AI and digital practice.'}
    </h2>

    <form
      class="subscribe-form"
      aria-label="Email subscription"
      action="https://chatmandu.substack.com/api/v1/free"
      method="post"
      target="substack-frame"
      id="subscribe-form"
    >
      <div class="subscribe-form__row">
        <label for="subscribe-email" class="subscribe-form__label">
          Email address
        </label>
        <div class="subscribe-form__fields">
          <input
            type="email"
            id="subscribe-email"
            name="email"
            class="subscribe-form__input"
            placeholder="you@example.com"
            required
            autocomplete="email"
            aria-required="true"
          />
          <button type="submit" class="subscribe-form__btn">
            Subscribe
          </button>
        </div>
      </div>
      <p class="subscribe-form__note">No spam. Unsubscribe any time.</p>
      <p
        class="subscribe-form__status"
        role="status"
        aria-live="polite"
        id="subscribe-status"
      ></p>
    </form>

    <!-- Hidden iframe catches the Substack response so the page doesn't navigate -->
    <iframe name="substack-frame" style="display:none" aria-hidden="true" title="Subscription result"></iframe>

  </div>
</section>

<script>
  (function () {
    const form = document.getElementById('subscribe-form');
    const status = document.getElementById('subscribe-status');
    if (!form || !status) return;

    form.addEventListener('submit', function (e) {
      const emailInput = form.querySelector('input[type="email"]');
      if (!emailInput || !emailInput.value.trim()) {
        e.preventDefault();
        status.textContent = 'Please enter your email address.';
        status.className = 'subscribe-form__status subscribe-form__status--error';
        emailInput && emailInput.focus();
        return;
      }
      // Form posts to hidden iframe — show confirmation immediately
      status.textContent = 'Done. Check your inbox to confirm your subscription.';
      status.className = 'subscribe-form__status subscribe-form__status--success';
      form.reset();
    });
  })();
</script>
