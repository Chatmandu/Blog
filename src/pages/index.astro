---
import BaseLayout from '../layouts/BaseLayout.astro';
import Subscribe from '../components/Subscribe.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const allNotes = await getCollection('notes', ({ data }) => !data.draft);

const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const [featured, ...rest] = posts;

// Curated "Start here" posts — marked featured: true in frontmatter,
// excluding the current latest post (already shown in the featured hero).
const startHerePosts = allPosts
  .filter(p => p.data.featured === true && p.slug !== featured?.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const recentNotes = allNotes
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-GB', {
    day: 'numeric', month: 'long', year: 'numeric',
  }).format(date);
}

function readingTime(content: string): string {
  const mins = Math.max(1, Math.round(content.trim().split(/\s+/).length / 200));
  return `${mins} min read`;
}
---

<BaseLayout title="Manual Mode" description="Essays on marketing, technology, AI and the places where they collide.">
  <!-- Person + WebSite schema is emitted by BaseLayout. No duplicate needed here. -->
  <div class="container--editorial">

    <!-- Masthead hero -->
    <section class="home-hero" aria-labelledby="hero-heading">
      <p class="home-hero__eyebrow">Manual Mode</p>
      <h1 class="home-hero__title" id="hero-heading">
        Writing about marketing, AI and digital change in higher education.
      </h1>
      <hr class="home-hero__rule" aria-hidden="true" />
      <p class="home-hero__sub">
        Essays on marketing, technology, AI and the places where they collide with culture, communication and how organisations work.
      </p>
      <!-- Identity block — visible above the fold on standard screens -->
      <div class="home-hero__bio">
        <img
          src="/images/niall-walsh.jpg"
          alt="Niall Walsh"
          width="48"
          height="48"
          loading="eager"
          decoding="async"
          class="home-hero__bio-portrait"
        />
        <p>
          I'm Niall Walsh, Head of Marketing at the
          <a href="https://www.lstmed.ac.uk/" target="_blank" rel="noopener noreferrer">Liverpool School of Tropical Medicine</a>.
          I write about higher education marketing, AI, digital strategy and the systems behind them.
          <a href="/about/">More about me</a> or <a href="/about/#contact">get in touch</a>.
        </p>
      </div>
    </section>

    <!-- Featured post — most recent, type as design -->
    {featured && (
      <section aria-label="Latest post" class="featured-hero">
        <p class="featured-hero__kicker">Latest</p>
        <h2 class="featured-hero__title">
          <a href={`/blog/${featured.slug}/`}>{featured.data.title}</a>
        </h2>
        {featured.data.description && (
          <p class="featured-hero__desc">{featured.data.description}</p>
        )}
        <div class="featured-hero__foot">
          <div class="featured-hero__meta">
            <time datetime={featured.data.pubDate.toISOString()}>
              {formatDate(featured.data.pubDate)}
            </time>
            <span aria-hidden="true">·</span>
            <span>{readingTime(featured.body)}</span>
          </div>
          {featured.data.tags.length > 0 && (
            <ul class="tags" role="list">
              {featured.data.tags.map(tag => (
                <li><a href={`/tags/${tag}/`} class="tag">{tag}</a></li>
              ))}
            </ul>
          )}
          <a href={`/blog/${featured.slug}/`} class="featured-hero__cta" aria-label={`Read ${featured.data.title}`}>
            Read &nbsp;&rarr;
          </a>
        </div>
      </section>
    )}

    <!-- Start here — curated selection for first-time visitors -->
    {startHerePosts.length > 0 && (
      <section class="start-here" aria-labelledby="start-here-label">
        <p class="section-label" id="start-here-label">
          Start here
        </p>
        <div class="start-here__grid">
          {startHerePosts.map(post => (
            <article class="start-here__item">
              {post.data.featuredLabel && (
                <p class="start-here__editorial">{post.data.featuredLabel}</p>
              )}
              <h2 class="start-here__title">
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              </h2>
              {post.data.description && (
                <p class="start-here__desc">{post.data.description}</p>
              )}
              <div class="start-here__meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
                <span aria-hidden="true">·</span>
                <span>{readingTime(post.body)}</span>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Subscription form -->
    <Subscribe />

    <!-- Two-column: essays left, sidebar right -->
    <div class="home-columns">

      <!-- Left: full post archive -->
      <section aria-labelledby="posts-label" class="home-columns__essays">
        <p class="section-label" id="posts-label">
          All essays
          <span class="section-label__count">{posts.length}</span>
        </p>
        <ul class="post-rows" role="list">
          {rest.map(post => (
            <li class="post-row">
              <a href={`/blog/${post.slug}/`} class="post-row__link" tabindex="-1" aria-hidden="true"></a>
              <div class="post-row__body">
                {post.data.tags.length > 0 && (
                  <ul class="tags post-row__tags" role="list">
                    {post.data.tags.map(tag => (
                      <li><a href={`/tags/${tag}/`} class="tag">{tag}</a></li>
                    ))}
                  </ul>
                )}
                <h2 class="post-row__title">
                  <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                </h2>
                {post.data.description && (
                  <p class="post-row__desc">{post.data.description}</p>
                )}
                <div class="post-row__meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                  <span aria-hidden="true">·</span>
                  <span>{readingTime(post.body)}</span>
                </div>
              </div>
              <span class="post-row__arrow" aria-hidden="true">&rarr;</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Right sidebar: bio + notes + RSS -->
      <aside class="home-columns__notes" aria-label="About and recent notes">

        <!-- Bio snippet -->
        <div class="sidebar-bio">
          <p class="sidebar-bio__text">
            Niall Walsh writes about higher education marketing, AI and digital practice.
            Head of Marketing at the
            <a href="https://www.lstmed.ac.uk/" target="_blank" rel="noopener noreferrer">Liverpool School of Tropical Medicine</a>.
          </p>
          <a href="/about/" class="sidebar-bio__link">About this site &rarr;</a>
        </div>

        <!-- Recent notes -->
        {recentNotes.length > 0 && (
          <>
            <p class="section-label" id="notes-label">
              Notes
              <a href="/notes/" class="section-label__link">All &rarr;</a>
            </p>
            <ul class="note-rows" role="list" aria-labelledby="notes-label">
              {recentNotes.map(note => (
                <li class="note-row">
                  <a href={`/notes/${note.slug}/`} class="note-row__link" tabindex="-1" aria-hidden="true"></a>
                  <div class="note-row__body">
                    <h2 class="note-row__title">
                      <a href={`/notes/${note.slug}/`}>{note.data.title}</a>
                    </h2>
                    <time class="note-row__date" datetime={note.data.pubDate.toISOString()}>
                      {formatDate(note.data.pubDate)}
                    </time>
                  </div>
                </li>
              ))}
            </ul>
          </>
        )}

        <!-- Subscribe prompt -->
        <div class="sidebar-subscribe">
          <p class="sidebar-subscribe__text">
            Get new essays by email when they're published.
          </p>
          <a href="/#subscribe" class="sidebar-subscribe__link">Subscribe &rarr;</a>
        </div>

        <!-- Footer links -->
        <p class="sidebar-footer-links">
          <a href="/rss.xml">RSS</a>
          <span aria-hidden="true">&middot;</span>
          <a href="https://www.linkedin.com/in/chatmandu/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </p>

      </aside>

    </div><!-- /home-columns -->

  </div>
</BaseLayout>
