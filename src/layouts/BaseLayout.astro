---
import '../styles/global.css';
import Header from '../components/Header.astro';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Essays on marketing, technology, AI and the places where they collide.',
  ogImage: ogImageProp,
  type = 'website',
} = Astro.props;

// Fall back to a default site image for pages without a specific OG image
const ogImage = ogImageProp ?? '/images/Eye.jpg';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'Manual Mode';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Niall Walsh" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`RSS Feed – ${siteName}`}
      href="/rss.xml"
    />

    <!-- Fonts — async to avoid render-blocking; optional removes font-swap CLS -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Preload so fonts start downloading immediately even though they're async -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500&display=optional"
    />
    <!-- media="print" makes this non-render-blocking; onload swaps to screen -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500&display=optional"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500&display=swap"
      />
    </noscript>

    <!-- JSON-LD: site-level Person + Blog schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": `${Astro.site}#niall`,
          "name": "Niall Walsh",
          "url": Astro.site,
          "image": new URL("/images/niall-walsh.jpg", Astro.site).toString(),
          "jobTitle": "Head of Marketing",
          "worksFor": {
            "@type": "Organization",
            "name": "Liverpool School of Tropical Medicine",
            "url": "https://www.lstmed.ac.uk/"
          },
          "description": "Writer on marketing, technology and AI, and the places where they collide with culture, communication and how organisations work.",
          "knowsAbout": [
            "Artificial intelligence",
            "AI search and generative engine optimisation",
            "Content design",
            "Digital marketing",
            "Higher education marketing",
            "Public sector communications"
          ],
          "sameAs": [
            "https://www.linkedin.com/in/chatmandu/",
            "https://medium.com/@chatmandu"
          ]
        },
        {
          "@type": "WebSite",
          "@id": `${Astro.site}#website`,
          "url": Astro.site,
          "name": "Manual Mode",
          "description": description,
          "publisher": { "@id": `${Astro.site}#niall` },
          "author": { "@id": `${Astro.site}#niall` },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": `${Astro.site}tags/{search_term_string}/`
            },
            "query-input": "required name=search_term_string"
          }
        }
      ]
    })} />

    <!-- Extra head tags injected by child layouts (article meta, JSON-LD, etc.) -->
    <slot name="head" />

    <!-- Dark mode: run inline before first paint to prevent flash -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored ?? (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <div class="site-content">
      <TopNav />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- Theme toggle logic -->
    <script>
      const btn = document.getElementById('theme-toggle') as HTMLButtonElement | null;
      const sun = document.getElementById('icon-sun') as SVGElement | null;
      const moon = document.getElementById('icon-moon') as SVGElement | null;

      function applyTheme(theme: string) {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
        if (sun) sun.style.display = theme === 'dark' ? 'block' : 'none';
        if (moon) moon.style.display = theme === 'light' ? 'block' : 'none';
      }

      // Sync icons with current state
      applyTheme(document.documentElement.getAttribute('data-theme') ?? 'light');

      btn?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        applyTheme(current === 'dark' ? 'light' : 'dark');
      });
    </script>
  </body>
</html>
